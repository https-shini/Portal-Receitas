# ════════════════════════════════════════════════════════════════
#  .env.example — modelo de variáveis de ambiente.
#
#  Copie para `.env` e ajuste os valores para o seu ambiente:
#      cp .env.example .env
#
#  O arquivo `.env` real É IGNORADO pelo Git (.gitignore) e NUNCA deve
#  ser versionado. Aqui vão apenas nomes de variáveis e valores de
#  exemplo/placeholder — jamais credenciais reais.
# ════════════════════════════════════════════════════════════════

# ── docker-compose (ambiente local) ──
# Porta pública do site no host (http://localhost:WEB_PORT).
WEB_PORT=8080

# ── Banco de dados (lidas por config/bootstrap.php — padrão 12-factor) ──
# Em docker-compose, DB_PASS também define a senha do root do MySQL.
DB_HOST=db
DB_PORT=3306
DB_NAME=tcc_receitas
DB_USER=root
DB_PASS=troque-esta-senha

# ── TLS do banco (opcional — provedores gerenciados) ──
# Caminho para o CA bundle; deixe vazio para conexão sem TLS.
DB_SSL_CA=
# "false" desativa a verificação do certificado (use só em teste).
DB_SSL_VERIFY=true
