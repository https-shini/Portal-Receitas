{
  "name": "Portal Receitas — Distribuição de publicação",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "portal-recipe-published" },
      "id": "trigger-published",
      "name": "Webhook recipe.published",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/follows?followee_id=eq.{{ $json.body.record.author_id }}&select=follower_id"
      },
      "id": "get-followers",
      "name": "Busca seguidores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/notifications",
        "sendBody": true,
        "jsonBody": "={{ $json.map(f => ({ user_id: f.follower_id, type: 'new_recipe', payload: { recipe_id: $('Webhook recipe.published').item.json.body.record.id } })) }}"
      },
      "id": "create-notifications",
      "name": "Cria notificações",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 220]
    },
    {
      "parameters": { "method": "POST", "url": "https://api.telegram.org/bot{{ $env.TELEGRAM_TOKEN }}/sendMessage" },
      "id": "telegram",
      "name": "Post no Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 400]
    },
    {
      "parameters": { "method": "GET", "url": "https://www.google.com/ping?sitemap={{ $env.SITE_URL }}/sitemap.xml" },
      "id": "seo-ping",
      "name": "Ping SEO",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 520]
    }
  ],
  "connections": {
    "Webhook recipe.published": {
      "main": [[
        { "node": "Busca seguidores", "type": "main", "index": 0 },
        { "node": "Post no Telegram", "type": "main", "index": 0 },
        { "node": "Ping SEO", "type": "main", "index": 0 }
      ]]
    },
    "Busca seguidores": { "main": [[{ "node": "Cria notificações", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
