{
  "name": "portal-receitas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Frontend React + Supabase do Portal de Receitas (migração)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "gen:types": "supabase gen types typescript --local > src/supabase/database.types.ts"
  },
  "dependencies": {
    "@sentry/react": "^8.33.1",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.1.2",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
